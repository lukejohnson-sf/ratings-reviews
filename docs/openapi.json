            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "type": "string"
                    },
                    "averageRating": {
                      "type": "number",
                      "example": 4.7
                    },
                    "totalReviews": {
                      "type": "integer",
                      "example": 1284
                    },
                    "recommendedPercent": {
                      "type": "integer",
                      "example": 96
                    },
                    "ratingDistribution": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "stars": {
                            "type": "integer"
                          },
                          "count": {
                            "type": "integer"
                          },
                          "percent": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "dimensions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "scale",
                              "rating"
                            ]
                          },
                          "minLabel": {
                            "type": "string"
                          },
                          "midLabel": {
                            "type": "string",
                            "nullable": true
                          },
                          "maxLabel": {
                            "type": "string"
                          },
                          "average": {
                            "type": "number",
                            "nullable": true,
                            "description": "1-5. For type=scale, 3 is ideal (e.g. true to size)."
                          }
                        }
                      }
                    },
                    "summaryText": {
                      "type": "string",
                      "description": "Review highlights. **bold** marks key themes."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
